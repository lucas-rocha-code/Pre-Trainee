//Código inicia

algoritmo "valores"
var
  N1, N2, S: inteiro
inicio
  escreval("Digite um número: ")
  Leia (N1)
  escreval("Digite outro número: ")
  Leia (N2)
  S <- N1 + N2
  escreval("A soma é ", S)
FimAlgoritmo

//Código final com todos os conceitos da aula:

algoritmo "conversor”
var
  angulo, S: Real
inicio
  Escreval("Informe um angulo: ")
  Leia (angulo)
  S <- Sen(GraupRad(angulo))
  Escreval("O Seno de ", angulo, "e igual a ", S)
fimalgoritmo